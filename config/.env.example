# Healthcare Transmission System Environment Configuration
# =====================================================
# Copy this file to .env and update with your actual values

# Environment
ENVIRONMENT=development
DEBUG=true

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pg_mq_poc
DB_USER=postgres
DB_PASSWORD=your_database_password

# OpenHIM Configuration
OPENHIM_URL=https://localhost:8080
OPENHIM_CLIENT_ID=healthcare_transmission
OPENHIM_CLIENT_PASSWORD=your_openhim_password
OPENHIM_VERIFY_SSL=false
OPENHIM_TIMEOUT=30

# SMS Configuration - Choose your provider
SMS_PROVIDER=twilio

# Twilio Configuration (if using Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
SMS_SENDER_NUMBER=+1234567890

# Africa's Talking Configuration (if using Africa's Talking)
AFRICASTALKING_USERNAME=your_africastalking_username
AFRICASTALKING_API_KEY=your_africastalking_api_key

# SMS Settings
SMS_MAX_LENGTH=160

# Network Monitoring
NETWORK_CHECK_INTERVAL=60
NETWORK_TIMEOUT=10
NETWORK_RETRY_ATTEMPTS=3
LOW_BANDWIDTH_THRESHOLD=1.0
HIGH_LATENCY_THRESHOLD=500.0

# Queue Configuration
DEFAULT_EXCHANGE=healthcare_exchange
DEFAULT_QUEUE=healthcare_queue
QUEUE_RETRY_LIMIT=3
QUEUE_RETRY_DELAY=5
MAX_MESSAGE_SIZE=65536

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE_PATH=logs/healthcare_transmission.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5